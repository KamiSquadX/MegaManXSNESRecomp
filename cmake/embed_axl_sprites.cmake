# Embed the Axl sidecar built from the tracked X8 16-bit art into C.
#
# Invoked with -P. The sidecar comes from assets/axl (Mega Man X8 16-bit by
# Alysson da Paz, shipped under its license), never from a game ROM.
# GigaCrash's two sounds are X8 16-bit's OGGs, decoded when Add Axl loads.
#
#   -DOUT=<file.c> -DSPRITES=<axl-v1.bin> -DGIGA_START=<ogg> -DGIGA_SHOT=<ogg>

foreach(_var OUT SPRITES GIGA_START GIGA_SHOT)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "embed_axl_sprites: ${_var} is required")
    endif()
endforeach()
set(_body "/* Generated by cmake/embed_axl_sprites.cmake. Do not edit. */\n")
string(APPEND _body "#include <stddef.h>\n#include <stdint.h>\n\n")
foreach(_pair "Sprites;${SPRITES}" "GigaStart;${GIGA_START}" "GigaShot;${GIGA_SHOT}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _path)
    file(SIZE "${_path}" _size)
    if(_size EQUAL 0)
        message(FATAL_ERROR "embed_axl_sprites: empty ${_path}")
    endif()
    file(READ "${_path}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n  " _bytes "${_bytes}")
    string(APPEND _body
        "const uint8_t kMmxAxlEmbedded${_name}[${_size}] = {\n  ${_bytes}\n};\n"
        "const size_t kMmxAxlEmbedded${_name}Size = ${_size};\n\n")
endforeach()
set(_tmp "${OUT}.tmp")
file(WRITE "${_tmp}" "${_body}")
file(COPY_FILE "${_tmp}" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${_tmp}")
